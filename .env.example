# Connection string for public.reclamante (existing Postgres).
# This host typically needs non-SSL: append ?sslmode=disable (or &sslmode=disable).
# Never commit real credentials. Prefer private publish when going live.
#
# Preferred for ingest (and required on Cursor Apps when the platform injects DATABASE_URL):
RECLAMANTE_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=disable
#
# Local / self-hosted fallback only. On Cursor Apps, DATABASE_URL may point at an
# internal host (e.g. postgres_postgres); the app ignores that host for form ingest
# and requires RECLAMANTE_DATABASE_URL instead. DATABASE_URL is a reserved secret name.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=disable
