# External Postgres (lusean) — one URL for the whole database, not per table.
# Prefer this name on Cursor Apps (fresh secret; avoids stale RECLAMANTE_DATABASE_URL values).
# Host must be the external IP (e.g. 187.41.98.57), never postgres_postgres.
# If the password has @ # % / : space, URL-encode only the password segment.
LUSEAN_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=disable
#
# Legacy alias (optional). Ignored when host is platform-internal (postgres_postgres).
RECLAMANTE_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=disable
#
# Local / self-hosted fallback. On Cursor Apps this is often the platform DB and is ignored
# when the host is internal. DATABASE_URL is a reserved secret name on publish-app.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=disable
#
# Portal session HMAC (cookie lusean_session). Set a long random string in production.
LUSEAN_SESSION_SECRET=replace-with-long-random-string
#
# First portal user (scripts/create-app-user.mjs) — never commit real values:
# APP_USER_LOGIN=
# APP_USER_PASSWORD=
# APP_USER_SCHEMA=sfragaadv
